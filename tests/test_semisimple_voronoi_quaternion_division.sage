r"""Voronoi unit generators of a maximal order in the indefinite quaternion division algebra B = (-1, 3)_Q.

B has the Q-basis 1, i, j, k = ij with i^2 = -1, j^2 = 3, ij = -ji. The Hilbert symbols (-1, 3)_2 = (-1, 3)_3 = -1 and
(-1, 3)_oo = 1 (3 > 0), so B is a division algebra of discriminant 6, split at the real place. B acts on itself by left
multiplication, which places B in M_4(Q); the determinant of that representation is nrd^2. The split model sends B into
M_2(Q(sqrt 3)) by i -> [[0, -1], [1, 0]] and j -> diag(sqrt 3, -sqrt 3). A subfield of B is Q or a quadratic field; the only
roots of unity in a maximal order are those of Q(i) and Q(sqrt -3), of finite order, while the norm-one group of the order is the
cocompact Fuchsian group of signature (0; 2, 2, 3, 3) (Shimizu covolume 2 pi / 3), which is infinite, so some unit has infinite order.
"""

from sage_extensions.all import *
from sage.matrix.constructor import matrix as sage_matrix
from sage.matrix.special import identity_matrix
from sage.rings.number_field.number_field import QuadraticField
from sage.rings.rational_field import QQ as SageQQ
from sage_indefinite_port.indefinite.quaternion_orders_number_field import MatrixAlgebraLattices, maximal_order
from sage_indefinite_port.indefinite.semisimple_voronoi import SemisimpleOrderVoronoi

_N = QuadraticField(int(3), "s")
_S = _N.gen()
# Multiplication table of the basis 1, i, j, k: _TABLE[a][b] = (sign, index) with e_a e_b = sign e_index (scalars from i^2 = -1, j^2 = 3).
_TABLE = [
    [(int(1), int(0)), (int(1), int(1)), (int(1), int(2)), (int(1), int(3))],
    [(int(1), int(1)), (int(-1), int(0)), (int(1), int(3)), (int(-1), int(2))],
    [(int(1), int(2)), (int(-1), int(3)), (int(3), int(0)), (int(-3), int(1))],
    [(int(1), int(3)), (int(1), int(2)), (int(3), int(1)), (int(3), int(0))],
]


def _left(a):
    r"""Return the 4x4 matrix of left multiplication by the basis element e_a, on the basis 1, i, j, k."""
    result = sage_matrix(SageQQ, int(4), int(4))
    for b in range(int(4)):
        sign, index = _TABLE[a][b]
        result[index, b] = sign
    return result


_IMAGES = [
    identity_matrix(_N, int(2)),
    sage_matrix(_N, [[int(0), int(-1)], [int(1), int(0)]]),
    sage_matrix(_N, [[_S, int(0)], [int(0), -_S]]),
]
_IMAGES.append(_IMAGES[int(1)] * _IMAGES[int(2)])


def _split(y):
    r"""Return the image in M_2(Q(sqrt 3)) of the element of B whose left-multiplication matrix is y."""
    coordinates = y.column(int(0))
    return sum((coordinates[a] * _IMAGES[a] for a in range(int(4))), sage_matrix(_N, int(2), int(2)))


def _engine():
    basis = [_left(a) for a in range(int(4))]
    lattices = MatrixAlgebraLattices(basis, identity_matrix(SageQQ, int(4)))
    order = maximal_order(lattices, basis)
    return SemisimpleOrderVoronoi(order, splitting=(_N, [_split]))


def test_split_model_is_a_homomorphism():
    for a in range(int(4)):
        for b in range(int(4)):
            assert _split(_left(a) * _left(b)) == _split(_left(a)) * _split(_left(b))


def test_units_are_integral_of_reduced_norm_plus_minus_one_and_one_has_infinite_order():
    engine = _engine()
    generators = engine.unit_generators()
    assert all(engine.in_order(g) and g.det() == int(1) for g in generators)
    # An element of SL_2(R) with |trace| > 2 is hyperbolic, hence of infinite order. The (0; 2, 2, 3, 3) group is generated by
    # elliptic elements, so the hyperbolic witness is sought among products of two generators as well.
    words = list(generators) + [g * h for g in generators for h in generators]
    assert any(_split(w).det() == int(1) and abs(_split(w).trace()) > int(2) for w in words)
