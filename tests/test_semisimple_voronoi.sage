r"""Voronoi unit generators of the order M_2(Z) in M_2(Q).

GL_2(Z) is generated by [[0,1],[1,0]], [[1,1],[0,1]] and diag(-1,1), and reduction modulo 3 maps it onto GL_2(F_3), of order
(9 - 1)(9 - 3) = 48. The generators found by the algorithm must be integral of determinant +-1 and reduce to a generating set of
GL_2(F_3).
"""

from sage_extensions.all import *
from sage.groups.matrix_gps.finitely_generated import MatrixGroup
from sage.matrix.constructor import matrix as sage_matrix
from sage.rings.finite_rings.finite_field_constructor import GF
from sage.rings.integer_ring import ZZ as SageZZ
from sage_indefinite_port.indefinite.semisimple_voronoi import SemisimpleOrderVoronoi


def _generators():
    basis = [sage_matrix(SageZZ, int(2), int(2), [int(1) if t == s else int(0) for t in range(int(4))]) for s in range(int(4))]
    return SemisimpleOrderVoronoi(basis).unit_generators()


def test_units_of_m2z_are_integral_of_determinant_plus_minus_one():
    generators = _generators()
    assert all(g.det() in set([int(1), int(-1)]) for g in generators)
    assert all(c in SageZZ for g in generators for c in g.list())


def test_units_of_m2z_reduce_onto_gl2_f3():
    field = GF(int(3))
    group = MatrixGroup([g.change_ring(field) for g in _generators()])
    assert group.order() == int(48)
