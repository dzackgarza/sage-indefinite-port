r"""The Bestvina-Savin ocean over Z[i], checked on Example 7.1 of arXiv:1104.1474 and on diag(1, -3).

Proved by the exact assertions, for the inputs below:

- Every returned generator lies in GL_2(Z[i]) and preserves f exactly. The scalar i I acts trivially.
- For Delta = 6 the orbit counts, labels and stabilizer orders are those printed in Example 7.1.
- For diag(1, -3), each generator of the quaternion route is equal to an exact word in the ocean side
  pairings, a stabilizer element and a power of i. So the quaternion group lies in the ocean group.

Conditional on the source:

- That the ocean generators generate all of PU(f) uses Theorems 5.1 and 6.1 of the source, through
  the argument in the module docstring. The tests do not prove those theorems.
- The orbifold Euler characteristic of diag(1, -3) is compared with a value derived by hand from the
  mass formula: the order Z<1,i,j,k> of (-1,3) has index 3 for norm-one units in the maximal order of
  discriminant 6, whose norm-one quotient has area 2 pi / 3. So SU/{+-1} has area 2 pi, and it has
  index 2 in PU(f), which gives chi = -1/2.

Only checked:

- The reverse inclusion, that the ocean generators lie in the group generated by the quaternion route,
  is checked through equal images in GL_2(F_p) at the split primes 5 and 13. Agreement of finite images
  is not a proof of equality of the arithmetic groups.
"""

from sage_extensions.all import *
from sage.matrix.constructor import matrix as sage_matrix
from sage.rings.rational_field import QQ as sage_QQ
from sage_indefinite_port.indefinite.anisotropic_binary_hermitian import (
    FORM as QUATERNION_FORM,
    scalar_kernel as quaternion_scalar,
    unitary_generators as quaternion_generators,
)
from sage_indefinite_port.indefinite.hermitian_ocean import (
    FIELD, I, HermitianOcean, cell_edges, cell_vertices, discriminant, is_anisotropic,
)
import builtins
import pytest


TWO = FIELD(int(2))
EXAMPLE = sage_matrix(FIELD, int(2), int(2), [FIELD(int(1)), (FIELD(int(1)) - I) / TWO, (FIELD(int(1)) + I) / TWO, FIELD(int(-1))])
DIAGONAL = sage_matrix(FIELD, int(2), int(2), [FIELD(int(1)), FIELD(int(0)), FIELD(int(0)), FIELD(int(-3))])


@pytest.fixture(scope="module")
def example():
    return HermitianOcean(EXAMPLE)


@pytest.fixture(scope="module")
def diagonal():
    return HermitianOcean(DIAGONAL)


def _rational(a, b):
    return sage_QQ((int(a), int(b)))


def test_example_discriminant_and_anisotropy():
    assert int(discriminant(EXAMPLE)) == int(6)
    assert is_anisotropic(EXAMPLE)


def test_inputs_outside_the_source_hypotheses_are_rejected():
    isotropic = sage_matrix(FIELD, int(2), int(2), [FIELD(int(1)), FIELD(int(0)), FIELD(int(0)), FIELD(int(-1))])
    definite = sage_matrix(FIELD, int(2), int(2), [FIELD(int(1)), FIELD(int(0)), FIELD(int(0)), FIELD(int(3))])
    not_integral = sage_matrix(FIELD, int(2), int(2), [FIELD(int(1)), I / FIELD(int(3)), -I / FIELD(int(3)), FIELD(int(-3))])
    for form in (isotropic, definite, not_integral):
        with pytest.raises(ValueError):
            HermitianOcean(form)


def test_example_cell_structure_is_the_printed_one(example):
    r"""Example 7.1: one cell orbit with values (-1, 1), trivial stabilizer, two edge orbits with inv = +-1."""
    assert len(example.cells) == int(1)
    cell = example.cells[int(0)]
    assert cell.label == (int(-1), int(1))
    assert len(cell.stabilizer) == int(1)
    edges = example.edge_orbits()
    assert sorted(e.label[int(0)] for e in edges) == [int(-1), int(1)]
    assert all(len(e.stabilizer) == int(1) for e in edges)


def test_example_vertices_are_the_printed_ones(example):
    r"""Example 7.1: inv takes the values 2, 0, -2, with stabilizers cyclic of orders 4, 3, 4."""
    orbits = {o.label[int(0)]: len(o.stabilizer) for o in example.vertex_orbits()}
    assert orbits == {int(2): int(4), int(0): int(3), int(-2): int(4)}


def test_example_square_has_the_printed_vertex_labels(example):
    labels = [example.vertex_invariant(v) for v in cell_vertices(example.cells[int(0)].representative)]
    cyclic = [labels[k:] + labels[:k] for k in range(int(4))]
    assert [int(2), int(0), int(-2), int(0)] in cyclic or [int(2), int(0), int(-2), int(0)][::int(-1)] in cyclic


def test_vertex_invariants_satisfy_the_edge_relation(example, diagonal):
    r"""inv(v) + inv(v') = 2 inv(e) for the two vertices of each edge (Proposition 7.2)."""
    for ocean in (example, diagonal):
        for orbit in ocean.cells:
            vertices = cell_vertices(orbit.representative)
            edges = cell_edges(orbit.representative)
            for k in range(int(4)):
                inv_edge = sum(ocean.value(v) for v in edges[k])
                assert ocean.vertex_invariant(vertices[k]) + ocean.vertex_invariant(vertices[(k - int(1)) % int(4)]) == int(2) * inv_edge


def test_example_euler_characteristic(example):
    r"""The signature (0; 3, 4, 4) has chi = 2 - 2/3 - 3/4 - 3/4 = -1/6."""
    assert example.orbifold_euler_characteristic() == _rational(int(-1), int(6))


def test_generators_preserve_the_form(example, diagonal):
    for ocean in (example, diagonal):
        assert all(ocean.is_unitary(g) for g in ocean.unitary_generators())
        assert all(ocean.is_unitary(g) and g.det() == FIELD.one() for g in ocean.special_unitary_generators())


def test_scalar_kernel_is_not_trivial(diagonal):
    z = diagonal.scalar_kernel()
    assert z != diagonal.identity and z ** int(4) == diagonal.identity and diagonal.is_unitary(z)
    assert z.det() == FIELD(int(-1))


def test_diagonal_euler_characteristic_is_the_mass_formula_value(diagonal):
    assert diagonal.orbifold_euler_characteristic() == _rational(int(-1), int(2))


def test_diagonal_form_agrees_with_the_quaternion_route(diagonal):
    assert DIAGONAL == QUATERNION_FORM


def test_quaternion_generators_are_words_in_the_ocean_group(diagonal):
    for g in (*quaternion_generators(), quaternion_scalar()):
        reduction = diagonal.reduce(g)
        assert diagonal.evaluate(reduction) == g


def test_reduction_of_an_ocean_generator(diagonal):
    g = diagonal.unitary_generators()[int(0)] * diagonal.unitary_generators()[int(1)]
    assert diagonal.evaluate(diagonal.reduce(g)) == g


def _image_group(generators, prime, root):
    def reduce_entry(c):
        coords = c.list()
        return int(int(coords[int(0)]) + int(coords[int(1)]) * root) % prime

    gens = [tuple(reduce_entry(c) for c in g.list()) for g in generators]
    identity = (int(1), int(0), int(0), int(1))
    seen, frontier = builtins.set([identity]), [identity]
    while frontier:
        a, b, c, d = frontier.pop()
        for e, f, h, k in gens:
            product = ((a * e + b * h) % prime, (a * f + b * k) % prime, (c * e + d * h) % prime, (c * f + d * k) % prime)
            if product not in seen:
                seen.add(product)
                frontier.append(product)
    return seen


@pytest.mark.parametrize("prime, root", [(int(5), int(2)), (int(13), int(5))])
def test_images_modulo_split_primes_agree(diagonal, prime, root):
    route = [*quaternion_generators(), quaternion_scalar()]
    assert _image_group(diagonal.unitary_generators(), prime, root) == _image_group(route, prime, root)
