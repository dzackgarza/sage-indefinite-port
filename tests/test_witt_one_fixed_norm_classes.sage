r"""O(L)-classes of fixed-norm vectors of L = U + (Z[phi], Tr), phi = (1 + sqrt 5)/2 (#40).

Coordinates (a, d, x, y) give X = [[a, x + y phi], [conj, d]], b(X, X) = -2 det X, Disc = 5,
reduction bound C^2 = |delta| Disc / 2 with delta = det X = -b/2. The norm-one units are
generated by -1 and epsilon = phi^2 = (3 + sqrt 5)/2. Expected answers by hand:

- b = 2, delta = -1, C^2 = 5/2, so a in {0, 1}. a = 1: beta = 0, d = -1, giving (1, -1, 0, 0).
  a = 0: N beta = 1 with 1 <= beta_1^2 < epsilon_1^2 and beta_1 > 0 gives beta = 1;
  gcd(Tr 1, Tr phi) = gcd(2, 1) = 1, so d = 0, giving (0, 0, 1, 0). The upper shear by
  t = phi sends (0, 0, 1, 0) to a = Tr(phi) = 1. So one class.
- b = -2, delta = 1: a = 1 gives (1, 1, 0, 0); a = 0 gives beta = phi, d = 0, (0, 0, 0, 1),
  which the upper shear by t = 1 sends to a = Tr(conj phi) = 1. So one class.
- b = 4, delta = -2, C^2 = 5: a = 1 gives (1, -2, 0, 0); a = 2 needs 2 | N(beta) - 2 for beta
  mod 2, true only for beta = 0, giving (2, -1, 0, 0); a = 0 needs N beta = 2, impossible as
  2 is inert in Q(sqrt 5). The swap and -1 send (1, -2, 0, 0) to (2, -1, 0, 0). So one class.
- b = 3: b(v, v) is even on L, so there is no vector.
- b = 8: a nonprimitive v = k u needs k^2 | 8, so k = 2 and b(u, u) = 2, one class by the
  first item; (1, -4, 0, 0) is primitive of norm 8. So all classes are the primitive ones and one more.

L = U + <2, -4> is the model for Z[sqrt 2]: beta = x + y sqrt 2, b = -2ad + 2x^2 - 4y^2, Disc = 8, and the
norm-one units are generated by -1 and epsilon = 3 + 2 sqrt 2. Its rational Witt index is one.

- b = 2, delta = -1, C^2 = 4, a in {0, 1, 2}. a = 1: (1, -1, 0, 0). a = 2: 2 | -1 + x^2 - 2y^2 for x, y in
  {0, 1} gives (2, 0, 1, 0) and (2, -1, 1, 1). a = 0: beta = 1 in the unit domain, gcd(Tr 1, Tr sqrt 2) = 2,
  so (0, 0, 1, 0) and (0, 1, 1, 0).
- The upper shear by t has new a = a + Tr(t conj beta) + N(t) d. For (0, 1, 1, 0), t = 1 + sqrt 2 gives
  a = 2 + 1 - 2 = 1; for (2, -1, 1, 1), t = 1 + sqrt 2 gives a = 2 + (2 - 4) - (-1) = 1. A vector with a = 1
  reduces to (1, -1, 0, 0). For (0, 0, 1, 0), t = 1 gives (2, 0, 1, 0).
- div(1, -1, 0, 0) = 1 and div(0, 0, 1, 0) = 2, since G (0, 0, 1, 0) = (0, 0, 2, 0). So two classes.
"""

from math import gcd

from sage_extensions.all import *
from sage.modules.free_module_element import vector as sage_vector
from sage.rings.integer_ring import ZZ as SageZZ
from sage_indefinite_port.indefinite.witt_one_hilbert import HilbertWittOneLattice
from sage_indefinite_port.indefinite.witt_one_fixed_norm_classes import (
    HilbertFixedNormClasses,
    witt_one_fixed_norm_vector_classes,
)


def _classes():
    return HilbertFixedNormClasses(HilbertWittOneLattice(int(5)))


def _v(*entries):
    return sage_vector(SageZZ, [SageZZ(int(c)) for c in entries])


def test_candidates_of_norm_two_are_the_hand_list():
    found = set([tuple(int(c) for c in v) for v in _classes().candidates(int(2))])
    assert found == set([(int(1), int(-1), int(0), int(0)), (int(0), int(0), int(1), int(0))])


def test_norms_two_minus_two_and_four_each_form_one_class():
    classes = _classes()
    for square in (int(2), int(-2), int(4)):
        assert len(classes.classes(square, False)) == int(1)


def test_transporter_carries_the_hand_representatives():
    classes = _classes()
    gram = HilbertWittOneLattice(int(5)).gram()
    for x, y in (
        (_v(1, -1, 0, 0), _v(0, 0, 1, 0)),
        (_v(1, 1, 0, 0), _v(0, 0, 0, 1)),
        (_v(1, -2, 0, 0), _v(2, -1, 0, 0)),
    ):
        h = classes.transporter(x, y)
        assert h * x == y
        assert h.transpose() * gram * h == gram


def test_primitive_and_nonprimitive_vectors_are_not_equivalent():
    assert _classes().transporter(_v(2, -2, 0, 0), _v(1, -4, 0, 0)) is None


def test_odd_norm_has_no_vectors():
    assert _classes().classes(int(3), False) == ()


def test_norm_eight_has_one_nonprimitive_class():
    classes = _classes()
    every = classes.classes(int(8), False)
    primitive = classes.classes(int(8), True)
    assert len(primitive) >= int(1)
    assert len(every) == len(primitive) + int(1)


def _sqrt_two_classes():
    return HilbertFixedNormClasses(HilbertWittOneLattice(int(2)))


def test_sqrt_two_candidates_of_norm_two_are_the_hand_list():
    found = set([tuple(int(c) for c in v) for v in _sqrt_two_classes().candidates(int(2))])
    assert found == set(
        [
            (int(1), int(-1), int(0), int(0)),
            (int(2), int(0), int(1), int(0)),
            (int(2), int(-1), int(1), int(1)),
            (int(0), int(0), int(1), int(0)),
            (int(0), int(1), int(1), int(0)),
        ]
    )


def test_sqrt_two_norm_two_transporters_and_the_divisor_obstruction():
    classes = _sqrt_two_classes()
    gram = HilbertWittOneLattice(int(2)).gram()
    for x, y in (
        (_v(0, 1, 1, 0), _v(1, -1, 0, 0)),
        (_v(2, -1, 1, 1), _v(1, -1, 0, 0)),
        (_v(0, 0, 1, 0), _v(2, 0, 1, 0)),
    ):
        h = classes.transporter(x, y)
        assert h * x == y
        assert h.transpose() * gram * h == gram
    assert classes.transporter(_v(1, -1, 0, 0), _v(0, 0, 1, 0)) is None


def test_u_plus_two_minus_four_has_two_classes_of_norm_two():
    lattice = Lattices(ZZ)("U") + Lattices(ZZ)([[int(2), int(0)], [int(0), int(-4)]])
    representatives = witt_one_fixed_norm_vector_classes(lattice, int(2), False)
    assert len(representatives) == int(2)
    assert all(int(lattice.b(v, v)) == int(2) for v in representatives)
    assert sorted(gcd(*(int(lattice.b(v, g)) for g in lattice.module_generators())) for v in representatives) == [
        int(1),
        int(2),
    ]
