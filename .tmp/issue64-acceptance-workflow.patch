From f1333a08f3d94d0aca27ef17bca37522295c0381 Mon Sep 17 00:00:00 2001
From: port-agent <port-agent@localhost>
Date: Fri, 6 Nov 2026 09:31:16 +0000
Subject: [PATCH] ci: run the branch samples sharded by their measured binding
 quantity

The matrix side of the shard decisions in .tmp/issue64-shard-decisions.md, which
is committed in 46ac1088 with the justfile change it needs.

Orthogonal_group's sample is memory-bound (6236 MiB undivided with five cases
resident), so its six rows name one selection per shard. vector_stabilizers is
memory-bound as well and runs 18 shards over an array ordered by measured peak,
so each shard is one heavy case plus at most one light one. vector_orbits is
time-bound and runs 3. isotropic_orbits and boundaries stay at one shard until
their per-case peaks are measured; the record names those measurements.

push grows 24 -> 48 rows; workflow_dispatch is unchanged at 74.
---
 .github/workflows/acceptance.yml | 24 +++++++++++++++++++++---
 1 file changed, 21 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/acceptance.yml b/.github/workflows/acceptance.yml
index 68c38678..a5b502d1 100644
--- a/.github/workflows/acceptance.yml
+++ b/.github/workflows/acceptance.yml
@@ -41,15 +41,33 @@ jobs:
           if os.environ["GITHUB_EVENT_NAME"] == "push":
               # #33's amended acceptance nodes run explicit branch samples on
               # push; full files remain available on workflow_dispatch.
-              sampled = {"reflective", "orthogonal_group", "vector_stabilizers", "vector_orbits", "isotropic_orbits", "boundaries"}
+              # A sample is partitioned by what binds it, measured per case:
+              # `orthogonal_group` is memory-bound and names one selection per
+              # shard, `vector_stabilizers` is memory-bound and is ordered by
+              # peak so round-robin pairs each heavy case with a light one, and
+              # the rest are split by time or not yet measurable.
+              sampled = {
+                  "reflective": (1, None),
+                  "orthogonal_group": (6, "orthogonal_group_{shard}"),
+                  "vector_stabilizers": (18, None),
+                  "vector_orbits": (3, None),
+                  "isotropic_orbits": (1, None),
+                  "boundaries": (1, None),
+              }
               include = [
                   {"family": f, "shard": i, "shards": n, "selection": ""}
                   for f, n in shards.items() if f not in sampled
                   for i in range(n)
               ]
               include.extend(
-                  {"family": f, "shard": 0, "shards": 1, "selection": f}
-                  for f in sorted(sampled)
+                  {
+                      "family": f,
+                      "shard": i,
+                      "shards": count,
+                      "selection": f if pattern is None else pattern.format(shard=i),
+                  }
+                  for f, (count, pattern) in sorted(sampled.items())
+                  for i in range(count)
               )
           else:
               include = [
