r"""Swan generators of `GL_2(O_K)` for `K = Q(\sqrt{-5})`, class number two and not Euclidean (#54).

`O = Z[w]`, `w = \sqrt{-5}`. The only nontrivial class is that of `p = (2, 1 + w)`, of norm 2. Its nonzero elements of least norm are
`\pm 2` (norm 4; `1 + w` has norm 6), and `p / 2O` has the two classes `0, 1 + w`, of which only `1 + w` generates `p` with `2`. So the singular
points modulo `O` are the class of `(1 + w) / 2` alone (module docstring of :mod:`bianchi_groups`).

`3` splits in `O` (`-5 \equiv 1` is a square modulo 3), so `P = (3, 1 + w)` has residue field `F_3`. The elementary matrices
`E_{12}(1), E_{12}(w), E_{21}(1)` of `SL_2(O)` reduce into the subgroup of `GL_2(F_3)` generated by the reductions of the generators."""

from sage.groups.matrix_gps.finitely_generated import MatrixGroup
from sage.matrix.constructor import matrix as sage_matrix
from sage.rings.number_field.number_field import QuadraticField
from sage_indefinite_port.indefinite.bianchi_groups import BianchiGroup, bianchi_generators, steinitz_general_linear_generators


def test_swan_generators_of_gl2_over_sqrt_minus_five():
    K = QuadraticField(int(-5), "w")
    w = K.gen()
    group = BianchiGroup(K)
    assert set(group._reduce(s)[0] for s in group.singular_points()) == set([group._reduce((int(1) + w) / int(2))[0]])
    generators = bianchi_generators(K)
    for g in generators:
        assert all(x.is_integral() for x in g.list())
        assert g.det().is_unit() and g.det() in K.ring_of_integers()
    product = sage_matrix(K, [[int(1), int(0)], [int(0), int(1)]])
    for g in generators:
        product = product * g
    assert all(x.is_integral() for x in product.list()) and product.det().is_unit()
    P = K.ideal([int(3), 1 + w])
    F = P.residue_field()
    reduce = lambda g: sage_matrix(F, 2, 2, [F(x) for x in g.list()])
    image = MatrixGroup([reduce(g) for g in generators])
    for e in ([[1, 1], [0, 1]], [[1, w], [0, 1]], [[1, 0], [1, 1]]):
        assert reduce(sage_matrix(K, e)) in image


def test_stabilizer_of_the_nonfree_lattice_o_plus_p():
    K = QuadraticField(int(-5), "w")
    w = K.gen()
    p = K.ideal([int(2), 1 + w])
    generators = steinitz_general_linear_generators(K, p)
    pinv = p**int(-1)
    for g in generators:
        assert g[0, 0].is_integral() and g[1, 1].is_integral()
        assert g[0, 1] in pinv and g[1, 0] in p
        assert g.det().is_unit() and g.det() in K.ring_of_integers()
    assert len(generators) > int(0)
