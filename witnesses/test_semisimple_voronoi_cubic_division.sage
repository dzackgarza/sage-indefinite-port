r"""Voronoi unit generators of a maximal order in the cubic division algebra D = (L/Q, sigma, 2).

L is the cubic subfield of Q(zeta_7), generated by theta = 2 cos(2 pi / 7) with theta^3 + theta^2 - 2 theta - 1 = 0 and
sigma(theta) = theta^2 - 2. The prime 2 is inert in L, so 2 is not a norm from L and D is a division algebra. D acts on itself by left
multiplication on the Q-basis theta^t u^i (u theta = sigma(theta) u, u^3 = 2), which places D in M_9(Q); the determinant of that
representation is nrd^3. A subfield of D has degree 1 or 3 over Q and contains no roots of unity but +-1, so every unit other than
+-1 has infinite order, and SL_1 of the order is a cocompact lattice in SL_3(R), hence infinite.
"""

from sage_extensions.all import *
from sage.matrix.constructor import matrix as sage_matrix
from sage.matrix.special import identity_matrix
from sage.rings.number_field.number_field import NumberField
from sage.rings.polynomial.polynomial_ring_constructor import PolynomialRing
from sage.rings.qqbar import AA
from sage.rings.rational_field import QQ as SageQQ
from sage_indefinite_port.indefinite.quaternion_orders_number_field import MatrixAlgebraLattices, maximal_order
from sage_indefinite_port.indefinite.semisimple_voronoi import SemisimpleOrderVoronoi

_R = PolynomialRing(SageQQ, "y")
_F = _R([int(-1), int(-2), int(1), int(1)])
_L = NumberField(_F, "c", embedding=_F.roots(AA, multiplicities=False)[int(0)])
_C = _L.gen()
_SIGMA = [_C, _C * _C - int(2), (_C * _C - int(2)) ** int(2) - int(2)]  # sigma^0, sigma^1, sigma^2 of c


def _coordinates(ell, i):
    r"""Return the coordinates of ell u^i on the basis c^t u^i, index 3 i + t."""
    row = [SageQQ(int(0))] * int(9)
    for t, a in enumerate(_L(ell).list()):
        row[int(3) * i + t] = a
    return row


def _left(ell, power):
    r"""Return the 9x9 matrix of left multiplication by ell u^power."""
    columns = []
    for i in range(int(3)):
        for t in range(int(3)):
            # ell u^p c^t u^i = ell sigma^p(c)^t u^(p+i)
            j = power + i
            coefficient = _L(ell) * _SIGMA[power] ** t * (int(2) if j >= int(3) else int(1))
            columns.append(_coordinates(coefficient, j % int(3)))
    return sage_matrix(SageQQ, columns).transpose()


def _split(y):
    r"""Return the image of y in M_3(L): y u^j = sum_m u^m sigma^{-m}(ell_i a) for y = sum ell_i u^i."""
    first = y.column(int(0))
    ells = [sum((first[int(3) * i + t] * _C ** t for t in range(int(3))), _L(int(0))) for i in range(int(3))]
    result = sage_matrix(_L, int(3), int(3))
    for i in range(int(3)):
        for j in range(int(3)):
            m = (i + j) % int(3)
            conjugate = sum((_L(ells[i]).list()[t] * _SIGMA[(int(3) - m) % int(3)] ** t for t in range(int(3))), _L(int(0)))
            result[m, j] += conjugate * (int(2) if i + j >= int(3) else int(1))
    return result


def _engine():
    basis = [_left(_C ** t, i) for i in range(int(3)) for t in range(int(3))]
    lattices = MatrixAlgebraLattices(basis, identity_matrix(SageQQ, int(9)))
    order = maximal_order(lattices, basis)
    return SemisimpleOrderVoronoi(order, splitting=(_L, [_split]))


def test_split_model_is_a_homomorphism():
    a, b = _left(_C, int(1)), _left(_C + int(1), int(2))
    assert _split(a * b) == _split(a) * _split(b)


def test_units_are_integral_of_reduced_norm_plus_minus_one_and_one_has_infinite_order():
    engine = _engine()
    generators = engine.unit_generators()
    one = identity_matrix(SageQQ, int(9))
    assert all(engine.in_order(g) and g.det() in set([int(1), int(-1)]) for g in generators)
    assert any(g != one and g != -one for g in generators)
