source "$HOME/.envrc"

# This host installs Docker through Snap, not /usr/bin. The Sage launchers use
# `docker` from PATH, and the QC interpreter/preparser run inside that container.
if [ -x /snap/bin/docker ]; then
    export PATH="/snap/bin:$PATH"
fi
export SAGE_BIN="/home/dzack/.local/bin/sage"
export SAGE_PYTHON_BIN="/home/dzack/.local/bin/sage-docker-python"
export SAGE_PREPARSE_BIN="/home/dzack/.local/bin/sage-docker-preparse"
export SAGE_JULIA_COMMAND="/home/dzack/.juliaup/bin/julia"
# This package, the repository root (tests.fixtures), the pinned VinAl backend,
# and the research preamble checkout (dzack_research.preamble).
# VinAl's Sage module is src/sage/vinal.py, not the obsolete site-packages
# copy used by the inherited reflective acceptance runner.
export PYTHONPATH="$(pwd)/src:$(pwd):/home/dzack/gitclones/vinal/src/sage:/home/dzack/research/src${PYTHONPATH:+:$PYTHONPATH}"
export MYPYPATH="/home/dzack/research/src${MYPYPATH:+:$MYPYPATH}"
export TMPDIR="$(pwd)/.tmp"
