source "$HOME/.envrc"

# Sage QC (~/ai-review-ci/justfiles/sage.just) requires the Sage executable path.
export SAGE_BIN="${SAGE_BIN:-/home/dzack/gitclones/sage-dev-allopts/sage}"
# This package, the repository root (tests.fixtures), and the research preamble
# (dzack_research.preamble), which is consumed from its checkout.
export PYTHONPATH="$(pwd)/src:$(pwd):/home/dzack/research/src${PYTHONPATH:+:$PYTHONPATH}"
export MYPYPATH="/home/dzack/research/src${MYPYPATH:+:$MYPYPATH}"

# Sage runs in the home bind mount; /tmp is outside that container.
export TMPDIR="$PWD/.tmp"
