%% For environments
\ifx\undefined\AmSprefix
 \def\AmSprefix{=}
\fi
\def\AmSstyle#1#2{%
 \expandafter\let\csname\AmSprefix#1\expandafter\endcsname\csname#1\endcsname
 \expandafter\let\csname end\AmSprefix#1\expandafter\endcsname\csname end#1\endcsname
 \expandafter\edef\csname#2\endcsname{\noexpand\begin{\AmSprefix#1}}%
 \expandafter\edef\csname end#2\endcsname{\noexpand\end{\AmSprefix#1}}}

\ifx\undefined\newtheoremcs
 \def\newtheoremcs#1#2{% #1 - Title; #2 - cs name
  \newtheorem{#2}{#1}[section]}
\fi
\def\addtheorem#1#2{% #1 - Title; #2 - cs name
 \expandafter\let\csname#2\endcsname\relax
 \expandafter\newtheoremcs\csname#2name\endcsname{#2}%
 \expandafter\ifx\csname#2name\endcsname\relax
  \expandafter\def\csname#2name\endcsname{#1}\fi
 \global\advance\count10-\@ne %% to save counters
 \expandafter\let\csname c@#2\endcsname\c@theorem
 \AmSstyle{#2}{#2}}

\theoremstyle{plain}
 \ifx\theoremname\undefined\def\theoremname{Theorem}\fi
 \newtheoremcs{\theoremname}{theorem}\AmSstyle{theorem}{theorem}
 \addtheorem{Proposition}{proposition}
 \addtheorem{Lemma}{lemma}
 \addtheorem{Corollary}{corollary}
 \addtheorem{Addendum}{addendum}

\theoremstyle{definition}
 \addtheorem{Definition}{definition}
 \addtheorem{Remark}{remark}
 \addtheorem{Example}{example}
 \addtheorem{Conjecture}{conjecture}
 \addtheorem{Convention}{convention}
 \addtheorem{Warning}{warning}
 \addtheorem{Problem}{problem}
 \addtheorem{Observation}{observation}

 \AmSstyle{figure}{figure}
 \AmSstyle{table}{table}
    
